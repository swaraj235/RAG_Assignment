# Environment configuration for College RAG Lab

# Hugging Face Token (Optional - recommended to avoid rate limits or access gated models)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=

# Model Settings
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
GENERATION_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# RAG Hyperparameters
DEFAULT_TOP_K=4
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# Device configuration ("cuda" or "cpu" - defaults to auto-detect)
# TORCH_DEVICE=cuda

# Optional: If extending pipeline to proprietary LLM APIs
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
